# Porta HTTP Keep-Alive (Render usa 10000 por padrão)
PORT=10000

# Token e IDs do seu Bot no Discord Developer Portal
DISCORD_BOT_TOKEN=seu_token_aqui
DISCORD_CLIENT_ID=id_da_aplicacao
DISCORD_GUILD_ID=id_do_servidor_do_criador

# Chave opcional da HenrikDev VALORANT API (ex: HDEV-...)
HENRIK_API_KEY=
